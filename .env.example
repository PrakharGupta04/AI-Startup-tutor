# Database configuration:
# Local development uses DATABASE_URL=file:./data/app.db with an empty DATABASE_AUTH_TOKEN.
# Hosted deployment (e.g. Turso) uses the libsql://... URL plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Authentication and Cohort Security:
# Production environments require new random secrets and codes of at least 12 characters.
# AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-see-readme
GROUP_NAME=My Group
GROUP_JOIN_CODE=change-me-member
INSTRUCTOR_CODE=change-me-instructor

# AI Provider configuration:
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
